# Backend Configuration
PORT=8000

# AWS S3 (optional for local development; local storage fallback will be used if unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Lambda Labs (optional for local development; cloud GPU will be reported as stopped if unset)
LAMBDA_LABS_API_KEY=
LAMBDA_LABS_SSH_KEY=
SSH_KEY_PATH=
LAMBDA_LABS_INSTANCE_TYPE=["gpu_1x_a10", "gpu_1x_a100", "gpu_1x_h100"]
